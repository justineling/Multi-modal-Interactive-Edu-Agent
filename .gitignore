# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# ---- Node / Frontend ----
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---- Env & Secrets ----
.env
.env.*
!.env.example

# ---- Data & Runtime ----
*.db
*.sqlite
*.sqlite3
# SQLite WAL 模式的伴生文件（-shm / -wal / -journal），必须一起忽略，
# 否则每次本地跑一遍服务都会往仓库里塞二进制脏文件
*.db-shm
*.db-wal
*.db-journal
data/uploads/
data/artifacts/
# 样本教材由 scripts/make_sample_pdf.py 现场生成，不入库（§10 第 5 条）
backend/data/*.pdf
# scripts/profile_latency.py 的剖析专用目录（样本 PDF / 独立 SQLite / 探针原始输出），
# 与正式 data/ 隔离，跑完可整个删掉，不入库
backend/data/profile/
uploads/
logs/
*.log

# ---- 联调截图（e2e / 真机验证的现场产物，仅供本地排查）----
frontend/.e2e-shots/

# ---- OS / Editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- WorkBuddy 项目数据（记忆与运行态）----
.workbuddy-ai/
