# ---------------------------------------------------------------------------
# 后端环境变量样例。复制为 backend/.env 后按需修改（.env 已被 .gitignore 忽略）。
# 全部变量都有默认值，不建 .env 也能直接启动（此时为 SQLite + 演示模式）。
# ---------------------------------------------------------------------------

# ---- 数据库 ----
# SQLite（默认，零外部依赖）
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PostgreSQL + pgvector（需先装 requirements-postgres.txt）
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/edu_spatial

# ---- LLM（OpenAI 兼容 /chat/completions）----
# 留空 = 演示模式：走内置确定性 MockGenerator，顶栏显示「演示模式」黄标
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# 轻量任务（形态路由 / 相关性评估）用小模型
LLM_MODEL_ROUTER=gpt-4o-mini
# 重档：作为 LLM_MODEL_ARTIFACT 的回退目标，也是将来更复杂任务的落点
LLM_MODEL_GENERATOR=gpt-4o
# 产物（结构化 AST）生成用哪一档。留空 = 跟随 LLM_MODEL_GENERATOR（= 换档前的行为）
# 为什么默认用轻量档：实测同一批 11 个回合契约通过率相同（0 次重试、0 次降级），
# 而产物阶段耗时 55.5s → 10.1s。回退重档有两种写法，任选其一：
#   LLM_MODEL_ARTIFACT=gpt-4o            （只换产物档位，最精确）
#   LLM_MODEL_ARTIFACT=  + GENERATOR=gpt-4o（完全等价于「全部走重档」）
# 注意：这一项必须与 LLM_BASE_URL 指向同一个 provider，否则模型名对不上会直接 404。
LLM_MODEL_ARTIFACT=deepseek-flash
# 分形态覆盖（默认留空 = 全局单档）。只有某个形态契约不稳时才用，例如：
# LLM_MODEL_ARTIFACT_BY_TYPE=anim_2d=deepseek-v4-pro,scene_3d=deepseek-v4-pro
# 键只能是 ppt / anim_2d / scene_3d，拼错会在启动时抛 ValueError（不静默忽略）
# LLM_MODEL_ARTIFACT_BY_TYPE=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ---- 产物生成执行策略（回退不依赖代码回滚）----
# 关闭后回到改动前的串行路径（正文流完再生成产物）
ARTIFACT_PARALLEL_ENABLED=true
# fork 时刻：after_first_token（默认，TTFT 结构上不受影响）/ immediate（需 A/B 通过才可用）
# 注意：immediate 会再省约 3.9s，但它把 TTFT 交给「provider 侧并发是否排队」这个未验证假设，
# 必须先做 A/B（TTFT P50/P90 与 T4 P90 三条同时满足）才允许写进 .env，不要写在这里。
ARTIFACT_FORK_MODE=after_first_token
# 进程内产物 LLM 并发安全阀（0 = 不限）。只在多标签页同时提问时兜底，不是调参旋钮
ARTIFACT_MAX_CONCURRENCY=8
# 产物侧遇 429 时，在**正文结束之后**串行重试几次（0 = 不重试，直接降级演示生成器）。
# 为什么不在 429 当场重试：那时正文还在流，两个请求会互相抢配额，重试成功率最低；
# 正文结束后系统里只剩这一个请求，同样的重试成功率高得多。
# 调大它的代价：每次重试都是一次完整调用（约 10~20s），且用户此时正在等产物。
ARTIFACT_RATE_LIMIT_RETRY=1

# ---- 检索与评估阈值（§7.3）----
GRADER_MATCH_THRESHOLD=0.55
GRADER_SUPPORT_THRESHOLD=0.35
GRADER_PARTIAL_THRESHOLD=0.30
RETRIEVAL_TOP_K=8
BM25_WEIGHT=0.35
VECTOR_WEIGHT=0.45
SECTION_BONUS_WEIGHT=0.15
PAGE_BONUS_WEIGHT=0.05

# ---- Embedding ----
# local = 确定性哈希向量（默认，无外部依赖）；remote = 调远程 embedding API
EMBEDDING_MODE=local
EMBEDDING_DIM=1536
EMBEDDING_MODEL=text-embedding-3-small

# ---- 文件与存储 ----
DATA_DIR=./data
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=600
# 每个 artifact 保留的版本数（超出后最老版本只读、不可 patch，永不物理删除）
ARTIFACT_VERSION_KEEP=20

# ---- 日志与 CORS ----
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
